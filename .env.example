# Required to start MoviesZoneFlix
BOT_TOKEN=123456:replace_with_botfather_token
API_ID=1234567
API_HASH=replace_with_my.telegram.org_api_hash
DATABASE_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
ADMINS=123456789

# Recommended runtime configuration
DATABASE_NAME=tgboxoffice
COLLECTION_NAME=tgboxoffice_files
# File-index channel IDs (space-separated, bot must be admin)
CHANNELS=-1001234567890
# Optional private log channel ID (bot must be admin)
LOG_CHANNEL=
PORT=8080

# Public support invite and update channel links (defaults are already configured)
SUPPORT_CHAT=movieszoneflixsearch
GRP_LNK=https://t.me/movieszoneflixsearch
CHNL_LNK=https://t.me/+Kmi6jBTE_MY4N2Q9
